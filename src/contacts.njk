<!DOCTYPE html>
<html lang="ru">

<head>
    <title>Контакты</title>
    {% include 'blocks/head.njk' %}
</head>

<body class="preload mp">
    <div class="main-wrapper-outer">
        {% include 'blocks/header.njk' %}
        <main class="main">

            <div class="block-main">
                <div class="container">
                    <div class="breadcrumbs">
                        <ul>
                            <li>
                                <a href="#" class="home">
                                    <svg aria-hidden="true" width="12" height="11">
                                        <use xlink:href="img/sprite.svg#home"></use>
                                    </svg>
                                </a>
                            </li>
                            <li><span>Контакты</span></li>
                        </ul>
                    </div>
                    <div class="block-main__titles">
                        <h1 class="title1 mini">Связаться с нами</h1>
                    </div>
                </div>
            </div>

            <div class="block-contacts">
                <img loading="lazy" src="img/image5.webp" alt="" class="bg2">
                <div class="container">
                    <div class="block-contacts__content">
                        <div class="block-contacts__body">
                            <div class="block-contacts__column">
                                <img src="img/bg7.webp" alt="" class="block-contacts__bg">
                                <div class="block-contacts__item">
                                    <div class="block-contacts__top">
                                        <div class="block-contacts__icon">
                                            <img src="img/icons/mail2.svg" alt="">
                                        </div>
                                        <div class="line1">
                                            <div class="btn-line btn-line1"></div>
                                            <div class="btn-line btn-line2"></div>
                                            <div class="line1__circle"></div>
                                        </div>
                                    </div>
                                    <div class="block-contacts__bottom">
                                        <a href="mailto:info@physic-solutions.ru">
                                            info@physic-solutions.ru
                                            <img src="img/icons/arrow3.svg" alt="">
                                        </a>
                                        <a href="mailto:sales@physic-solutions.ru">
                                            sales@physic-solutions.ru
                                            <img src="img/icons/arrow3.svg" alt="">
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <div class="block-contacts__column">
                                <img src="img/bg7.webp" alt="" class="block-contacts__bg">
                                <div class="block-contacts__item">
                                    <div class="block-contacts__top">
                                        <div class="block-contacts__icon">
                                            <img src="img/icons/phone2.svg" alt="">
                                        </div>
                                        <div class="line1">
                                            <div class="btn-line btn-line1"></div>
                                            <div class="btn-line btn-line2"></div>
                                            <div class="line1__circle"></div>
                                        </div>
                                    </div>
                                    <div class="block-contacts__bottom">
                                        <a href="tel:79966865307" class="contacts-phone">
                                            +7 (996) 686-53-07
                                        </a>
                                        <a href="tel:79935432834" class="contacts-phone">
                                            +7 (993) 543-28-34
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <div class="block-contacts__column">
                                <img src="img/bg7.webp" alt="" class="block-contacts__bg">
                                <div class="block-contacts__item">
                                    <div class="block-contacts__top">
                                        <div class="block-contacts__icon">
                                            <img src="img/icons/map2.svg" alt="">
                                        </div>
                                        <div class="line1">
                                            <div class="btn-line btn-line1"></div>
                                            <div class="btn-line btn-line2"></div>
                                            <div class="line1__circle"></div>
                                        </div>
                                    </div>
                                    <div class="block-contacts__bottom">
                                        <p>
                                            625013, Тюменская обл.,г. Тюмень, ул. Пермякова 1,БЦ «Нобель», офис №615
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div id="map"></div>
                    </div>
                </div>
            </div>

            <div class="block-banner block-banner-form">
                <img loading="lazy" src="img/bg5.webp" alt="" class="block-banner__bg1 desc">
                <img loading="lazy" src="img/bg5-mob.webp" alt="" class="block-banner__bg1 mob">
                <div class="bg3">
                    <span></span>
                    <img src="img/icons/bg-white.svg" alt="">
                </div>
                <div class="bg4">
                    <span></span>
                    <img src="img/icons/bg-violet.svg" alt="">
                </div>
                <div class="container">
                    <div class="block-banner__content">
                        <div class="block-banner__top">
                            <h2 class="title2">
                                Отправить сообщение
                            </h2>
                            <p>
                                Вы можете отправить электронное письмо, заполнив форму или написав на почтовый ящик
                            </p>
                        </div>
                        <form action="#" class="form">
                            <div class="form__inputs">
                                <div class="form__column">
                                    <div class="form__input">
                                        <input data-required autocomplete="off" type="text" name="form[1]"
                                            placeholder="Имя" class="input">
                                    </div>
                                    <div class="form__input">
                                        <input data-required autocomplete="off" type="text" name="form[1]"
                                            placeholder="Email" class="input">
                                    </div>
                                </div>
                                <div class="form__input">
                                    <textarea placeholder="Сообщение" class="input textarea"></textarea>
                                </div>
                            </div>
                            <div class="form__bottom">
                                <button type="submit" class="btn btn-white">
                                    <span>Отправить</span>
                                    <img src="img/icons/arrow3.svg" alt="">
                                </button>
                                <div class="form__text">
                                    Нажимая на кнопку”Отправить” я принимаю пользовательское соглашение и <a href="./">
                                        политику
                                        конфиденциальности
                                    </a>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            {% include 'blocks/cookie.njk' %}

        </main>
        {% include 'blocks/footer.njk' %}
    </div>
    {% include 'blocks/popups.njk' %}
    {% include 'blocks/scripts.njk' %}
</body>

</html>