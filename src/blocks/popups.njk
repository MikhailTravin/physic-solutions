<div id="call" aria-hidden="true" class="popup popup-forms">
    <div class="popup__wrapper">
        <div class="popup__content">
            <div class="bg3">
                <span></span>
                <img src="img/icons/bg-white.svg" alt="">
            </div>
            <div class="bg4">
                <span></span>
                <img src="img/icons/bg-violet.svg" alt="">
            </div>
            <img src="img/bg8.webp" alt="" class="popup__pic1">
            <div class="popup-forms__body">
                <div class="popup-forms__top">
                    <div class="popup-forms__title">Заказать звонок</div>
                    <p>
                        Оставьте свой номер телефона
                        и наш менеджер с вами свяжется
                    </p>
                </div>
                <form action="#" class="form">
                    <div class="form__inputs">
                        <div class="form__input">
                            <input data-required autocomplete="off" type="text" name="form[1]" placeholder="Имя"
                                class="input">
                        </div>
                        <div class="form__input">
                            <input data-required autocomplete="off" type="text" name="form[1]" placeholder="Телефон"
                                class="input telephone">
                        </div>
                    </div>
                    <div class="form__bottom">
                        <button type="submit" class="btn btn-white">
                            <span>Отправить</span>
                            <img src="img/icons/arrow3.svg" alt="">
                        </button>
                        <div class="form__text">
                            Нажимая на кнопку”Отправить” я принимаю пользовательское соглашение и <a href="./">
                                политику
                                конфиденциальности
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>